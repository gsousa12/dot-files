[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-e": "project_panel::ToggleFocus",
      "ctrl-shift-q": "git_panel::ToggleFocus",
      "ctrl-shift-x": "zed::Extensions",
      "ctrl-shift-f": "pane::DeploySearch",
      "ctrl-alt-shift-t": [
        "task::Spawn",
        {
          "task_name": "Abrir terminal externo na pasta do arquivo"
        }
      ],
      "alt-shift-f": ["task::Spawn", { "task_name": "feat: menu" }],
      "alt-shift-n": ["task::Spawn", { "task_name": "feat: nova feature" }],
      "alt-shift-u": ["task::Spawn", { "task_name": "feat: rodar serviços (up)" }],
      "alt-shift-d": ["task::Spawn", { "task_name": "feat: parar serviços (down)" }]
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-left": "project_panel::CollapseAllEntries"
    }
  }
]
